#!/usr/bin/env bash
# pre-commit: two guards.
#
# 1. Game assets (ROMs, battery saves, save states) are never committed. The
#    Emerald ROM is copyrighted and operator-supplied.
# 2. An active worklog must have been updated since the last commit. The
#    worklog body lives under docs/worklogs/active/; the root WORKLOG.md is a
#    gitignored pointer. Either counts as "the worklog" for freshness.
#
# --no-verify is forbidden. If a commit is unrelated to the active worklog,
# archive the worklog first.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

ASSET_PATTERN='\.(gba|gbc|gb|sav|ss[0-9]|state)$'

blocked=()
while IFS= read -r -d '' path; do
    if printf '%s' "$path" | grep -Eiq "$ASSET_PATTERN"; then
        blocked+=("$path")
    fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if (( ${#blocked[@]} > 0 )); then
    {
        echo
        echo "❌ pre-commit: refusing to commit game assets (ROM / save / save state):"
        printf '   %s\n' "${blocked[@]}"
        echo
        echo "The ROM is referenced via POKEBENCH_ROM and never committed."
        echo
    } >&2
    exit 1
fi

# BSD stat (macOS) first, then GNU. GNU `stat -f` means "filesystem status": it
# prints a report and exits non-zero, so a failed attempt's output is discarded.
mtime() {
    local out args
    for args in "-f %m" "-c %Y"; do
        # shellcheck disable=SC2086
        if out=$(stat $args "$1" 2>/dev/null); then
            printf '%s\n' "$out"
            return 0
        fi
    done
    echo "pre-commit: cannot read mtime of $1" >&2
    return 1
}

worklogs=()
[[ -f WORKLOG.md ]] && worklogs+=("WORKLOG.md")
shopt -s nullglob
for body in docs/worklogs/active/*.md; do
    worklogs+=("$body")
done
shopt -u nullglob

# Archiving moves a body from docs/worklogs/active/ to docs/worklogs/ under the same name. The
# archived body counts as the worklog for this commit, so it must be updated like any other.
# Read without rename detection, so an edited body still pairs as delete + add. Paths are
# compared as literal strings, never as Git pathspecs.
deleted=() added=()
while IFS= read -r -d '' path; do
    deleted+=("$path")
done < <(git diff --cached --name-only -z --no-renames --diff-filter=D)
while IFS= read -r -d '' path; do
    added+=("$path")
done < <(git diff --cached --name-only -z --no-renames --diff-filter=A)
for from in ${deleted[@]+"${deleted[@]}"}; do
    [[ $from == docs/worklogs/active/* ]] || continue
    name=${from#docs/worklogs/active/}
    [[ $name == *.md && $name != */* ]] || continue
    for to in ${added[@]+"${added[@]}"}; do
        if [[ $to == "docs/worklogs/$name" ]]; then
            worklogs+=("$to")
        fi
    done
done

if (( ${#worklogs[@]} == 0 )); then
    exit 0
fi

if ! HEAD_TS=$(git log -1 --format=%ct HEAD 2>/dev/null); then
    exit 0
fi

newest=0
for file in "${worklogs[@]}"; do
    ts=$(mtime "$file") || exit 1
    (( ts > newest )) && newest=$ts
done

if (( newest <= HEAD_TS )); then
    {
        echo
        echo "❌ pre-commit: the active worklog has not been updated since the last commit."
        echo
        echo "Update it now: check off items, record the previous SHA, test counts and gate status."
        printf '   %s\n' "${worklogs[@]}"
        echo
    } >&2
    exit 1
fi
exit 0
