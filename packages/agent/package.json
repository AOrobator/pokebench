  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && eslint .",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
