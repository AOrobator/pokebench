    },
    "./run-control": {
      "types": "./src/run-control.ts",
      "default": "./dist/run-control.js"
    },
    "./local-endpoint": {
      "types": "./src/local-endpoint.ts",
      "default": "./dist/local-endpoint.js"
    },
    "./run": {
      "types": "./src/run.ts",
      "default": "./dist/run.js"
    },
    "./spectator": {
      "types": "./src/spectator.ts",
      "default": "./dist/spectator.js"
    },
    "./milestones": {
      "types": "./src/milestones.ts",
      "default": "./dist/milestones.js"
    },
    "./serial-comparison": {
      "types": "./src/serial-comparison.ts",
      "default": "./dist/serial-comparison.js"
    },
    "./experiments": {
      "types": "./src/experiments.ts",
