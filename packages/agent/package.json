{
  "name": "@pokebench/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./events": {
      "types": "./src/events.ts",
      "default": "./dist/events.js"
    },
    "./features": {
      "types": "./src/features.ts",
      "default": "./dist/features.js"
    },
    "./play-preset": {
      "types": "./src/play-preset.ts",
