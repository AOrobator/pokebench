     "state_seq": 122855,
     "map": "SLATEPORT CITY OCEANIC MUSEUM 2F",
     "map_id": [
      9,
      8
     ],
     "position": {
      "x": 12,
      "y": 6
     },
     "speaker": "ARCHIE",
     "speaker_source": "faced_sprite",
     "text": "The consequences will cost you\ndearly!"
    },
