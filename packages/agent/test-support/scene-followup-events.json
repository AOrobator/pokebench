     "state_seq": 122861,
     "map": "SLATEPORT CITY OCEANIC MUSEUM 2F",
     "map_id": [
      9,
      8
     ],
     "position": {
      "x": 12,
      "y": 6
     },
     "speaker": "ARCHIE",
     "speaker_source": "faced_sprite",
     "text": "And don't you forget it!"
    },
    {
     "state_seq": 122867,
     "map": "SLATEPORT CITY OCEANIC MUSEUM 2F",
     "map_id": [
      9,
      8
     ],
     "position": {
      "x": 12,
      "y": 6
     },
     "speaker": "CAPT. STERN",
     "speaker_source": "name_prefix",
     "text": "CAPT. STERN: You're\u2026\nAh, okay, you're AAAAA\u2026"
    },
    {
     "state_seq": 122873,
     "map": "SLATEPORT CITY OCEANIC MUSEUM 2F",
     "map_id": [
      9,
      8
     ],
     "position": {
      "x": 12,
      "y": 6
     },
     "speaker": "CAPT. STERN",
     "speaker_source": "name_prefix",
     "text": "Anyway, that was a tense situation!\nThank you for saving us!"
    },
    {
     "state_seq": 122879,
     "map": "SLATEPORT CITY OCEANIC MUSEUM 2F",
     "map_id": [
      9,
      8
     ],
     "position": {
      "x": 12,
      "y": 6
     },
     "speaker": "CAPT. STERN",
     "speaker_source": "name_prefix",
     "text": "Oh, yes, I almost forgot that you\neven brought the parts from DEVON!"
    },
    {
     "state_seq": 122885,
     "map": "SLATEPORT CITY OCEANIC MUSEUM 2F",
     "map_id": [
      9,
      8
     ],
     "position": {
      "x": 12,
      "y": 6
     },
     "speaker": "CAPT. STERN",
     "speaker_source": "name_prefix",
     "text": "CAPT. STERN: Whoops!\nThere's no time to lose!"
    },
    {
     "state_seq": 122892,
     "map": "SLATEPORT CITY OCEANIC MUSEUM 2F",
     "map_id": [
      9,
      8
     ],
     "position": {
      "x": 12,
      "y": 6
     },
     "speaker": "CAPT. STERN",
     "speaker_source": "name_prefix",
     "text": "We have to set out on our ocean-floor\nexpedition really soon."
    },
    {
     "state_seq": 122898,
     "map": "SLATEPORT CITY OCEANIC MUSEUM 2F",
     "map_id": [
      9,
      8
     ],
     "position": {
      "x": 12,
      "y": 6
     },
     "speaker": "CAPT. STERN",
     "speaker_source": "name_prefix",
     "text": "Thanks again, but now I've got\nto go!"
