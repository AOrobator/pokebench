    {
     "state_seq": 122796,
     "map": "SLATEPORT CITY OCEANIC MUSEUM 2F",
     "map_id": [
      9,
      8
     ],
     "position": {
      "x": 12,
      "y": 6
     },
     "speaker": "ARCHIE",
     "speaker_source": "faced_sprite",
     "text": "What makes you interfere with us?"
