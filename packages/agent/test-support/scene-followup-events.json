       "local_id": 3,
       "graphics_id": 117,
       "sprite_kind": "AQUA_MEMBER_M",
       "x": 26,
       "y": 21,
       "character": null
      },
      {
       "local_id": 4,
       "graphics_id": 23,
       "sprite_kind": "MAN_2",
       "x": 26,
       "y": 24,
       "character": null
      }
     ]
    },
    {
     "state_seq": 25351,
     "map": "PETALBURG WOODS",
     "map_id": [
      24,
      11
     ],
     "position": {
      "x": 26,
      "y": 23
     },
     "speaker": null,
     "speaker_source": null,
     "text": "And, hey, we of TEAM AQUA are also\nafter something in RUSTBORO.",
     "on_screen": [
      {
       "local_id": 3,
       "graphics_id": 117,
       "sprite_kind": "AQUA_MEMBER_M",
       "x": 26,
       "y": 21,
       "character": null
      },
      {
       "local_id": 4,
       "graphics_id": 23,
       "sprite_kind": "MAN_2",
       "x": 26,
       "y": 24,
       "character": null
      }
     ]
    },
    {
     "state_seq": 25357,
     "map": "PETALBURG WOODS",
     "map_id": [
      24,
      11
     ],
     "position": {
      "x": 26,
      "y": 23
     },
     "speaker": null,
     "speaker_source": null,
     "text": "I'll let you go today!",
     "on_screen": [
      {
       "local_id": 3,
       "graphics_id": 117,
       "sprite_kind": "AQUA_MEMBER_M",
       "x": 26,
       "y": 21,
       "character": null
      },
      {
       "local_id": 4,
       "graphics_id": 23,
       "sprite_kind": "MAN_2",
       "x": 26,
       "y": 24,
       "character": null
      }
     ]
    },
    {
     "state_seq": 25363,
