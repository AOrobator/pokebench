      11
     ],
     "position": {
      "x": 26,
      "y": 23
     },
     "speaker": "MAN_2",
     "speaker_source": "faced_sprite",
     "text": "Didn't that TEAM AQUA thug say\nthey were after something in\nRUSTBORO, too?"
