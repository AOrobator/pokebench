     "map": "PETALBURG WOODS",
     "map_id": [
      24,
      11
     ],
     "position": {
      "x": 26,
      "y": 23
     },
     "speaker": null,
     "speaker_source": null,
     "text": "I wish I could say that, but I'm out of\nPOK\u00e9MON\u2026",
     "on_screen": [
