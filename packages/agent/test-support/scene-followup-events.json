     "state_seq": 122904,
     "map": "SLATEPORT CITY OCEANIC MUSEUM 2F",
     "map_id": [
      9,
      8
     ],
     "position": {
      "x": 12,
      "y": 6
     },
     "speaker": "CAPT. STERN",
     "speaker_source": "name_prefix",
