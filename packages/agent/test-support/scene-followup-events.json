    },
    {
     "state_seq": 25339,
     "map": "PETALBURG WOODS",
     "map_id": [
      24,
      11
     ],
     "position": {
      "x": 26,
      "y": 23
     },
     "speaker": null,
     "speaker_source": null,
     "text": "Grrr\u2026 You've got some nerve\nmeddling with TEAM AQUA!\nCome on and battle me again!",
