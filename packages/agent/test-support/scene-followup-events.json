     "map": "SLATEPORT CITY OCEANIC MUSEUM 2F",
     "map_id": [
      9,
      8
     ],
     "position": {
      "x": 12,
      "y": 6
     },
     "speaker": "ARCHIE",
     "speaker_source": "faced_sprite",
     "text": "But, I warn you, don't even consider\ninterfering with our plans again."
